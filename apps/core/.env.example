# Auth Service Configs
NODE_ENV="development"

# Redis Config
REDIS_PORT="6379"
REDIS_HOST="127.0.0.1"

# Database environment
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/live_bid"
SERVICE_NAME="live-bid/core-service"

# Email Config
EMAIL_SERVICE="email service"
EMAIL_USER="your@email.service"
EMAIL_PASS="pass"
EMAIL_FROM="Live Bid <livebid@service.com>"
EMAIL_REPLAY="noreaplay@live-bid.com"
EMAIL_HOST="host"

# Email Notifications(Login, Register and ...)
EMAIL_NON_CRITICAL_ENABLED="true" # true or false/empty

# Nest running on the host (your current host compose, port 8080 is published)
WORDPRESS_GRAPHQL_URL=http://localhost:8080/graphql
# Nest running inside the same Docker network
# WORDPRESS_GRAPHQL_URL=http://wordpress/graphql
WORDPRESS_GRAPHQL_SECRET=your-long-random-secret

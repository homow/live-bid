# Auth Service Configs
NODE_ENV="development"

# Redis Config
REDIS_PORT="6379"
REDIS_HOST="127.0.0.1"

# JWT configs
JWT_EXPIRES="7d"
# run in linux: openssl rand -hex 64
# or run with node: node -e "console.log(require('crypto').randomBytes(64).toString('hex'));"
JWT_SECRET="JWT_SECRET"

# Database enviroment
DATABASE_URL="postgresql://user:password@127.0.0.1:5432/live_bid"


# Email Config
EMAIL_SERVICE="service"
EMAIL_USER="your-mail@service.co"
EMAIL_PASS="xxxx xxxx xxxx xxxx"
EMAIL_FROM="Live Bid <livebid@service.com>"
EMAIL_REPLAY="noreaplay@live-bid.com"
EMAIL_HOST="email host"

# Email Notifications(Login, Singup and ...)
EMAIL_NOTIFICATIONS_ENABLED="true" // true or false/empty

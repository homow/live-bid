# WordPress container settings (used by the infra compose files).
# DB values must match the ones in .env.wordpress-db.
WORDPRESS_DB_NAME=live_bid_cms
WORDPRESS_DB_USER=live_bid_cms
WORDPRESS_DB_PASSWORD=change-me

# Address of the WP admin panel. WordPress builds its own links from this.
WORDPRESS_SITE_URL=http://localhost:8080

# run: openssl rand -hex 32
LIVEBID_GRAPHQL_SECRET=your-long-random-secret

# Used once, on the first-boot install.
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.com

# Object storage. Leave S3_BUCKET empty to keep uploads on local disk (dev).
# Fill in every S3_* value to offload uploads to the bucket (prod).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_PATH_STYLE=true

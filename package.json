{
  "name": "live-bid",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "workspaces": [
    "apps/*",
    "clients/*",
    "packages/*"
  ],
  "scripts": {
    "build:packages": "npm run build --workspace=packages/contracts",
    "build:gateway": "nest build gateway",
    "build:auth": "nest build auth",
    "build:core": "nest build core",
    "build:web": "npm run build --workspace=clients/web",
    "build:all": "npm run build:packages && concurrently \"npm:build:gateway\" \"npm:build:core\" \"npm:build:auth\" \"npm:build:web\"",
    "dev:packages": "npm run build --workspace=packages/contracts -- --watch",
    "dev:gateway": "nest start gateway --watch",
    "dev:auth": "nest start auth --watch",
    "dev:core": "nest start core --watch",
    "dev:web": "npm run dev --workspace=clients/web",
    "dev:services": "concurrently -n pkgs,gateway,auth,core,web -c gray,cyan,yellow,blue,green \"npm:dev:packages\" \"npm:dev:gateway\" \"npm:dev:core\" \"npm:dev:auth\" \"npm:dev:web\"",
    "dev": "npm run build:packages && npm run dev:services"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@nestjs/apollo": "^13.4.4",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.4.4",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/microservices": "^11.1.29",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.1.29",
    "@nestjs/websockets": "^11.1.29",
    "@types/bcrypt": "^6.0.0",
    "@types/uuid": "^10.0.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "graphql-redis-subscriptions": "^2.7.0",
    "graphql-ws": "^6.2.1",
    "ioredis": "^6.0.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.23.0",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "eslint": "^9.18.0",
    "globals": "^17.0.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
